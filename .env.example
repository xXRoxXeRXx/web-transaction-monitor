# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Scheduling Configuration
SCHEDULE_INTERVAL=300
PROMETHEUS_PORT=8000

# Logging Configuration
# Set DEBUG=true to show all INFO logs, false (or omit) to show only ERROR logs
DEBUG=false

# HiDrive Next Credentials
HIDRIVE_NEXT_URL=https://id.ionos.fr/identifier?
HIDRIVE_NEXT_USER=your_username
HIDRIVE_NEXT_PASS=your_password

# HiDrive Legacy Credentials
HIDRIVE_LEGACY_URL=https://hidrive.ionos.com/#login
HIDRIVE_LEGACY_USER=your_username
HIDRIVE_LEGACY_PASS=your_password

# IONOS Nextcloud Workspace Credentials
IONOS_NEXTCLOUD_WORKSPACE_URL=https://workspace.kallisto45.de/login
IONOS_NEXTCLOUD_WORKSPACE_USER=your_username
IONOS_NEXTCLOUD_WORKSPACE_PASS=your_password

# IONOS Managed Nextcloud Credentials
IONOS_MANAGED_NEXTCLOUD_URL=https://storage.ionos.fr/login
IONOS_MANAGED_NEXTCLOUD_USER=your_username
IONOS_MANAGED_NEXTCLOUD_PASS=your_password

# MagentaCloud Credentials
MAGENTACLOUD_URL=https://magentacloud.example.com/login
MAGENTACLOUD_USER=your_username
MAGENTACLOUD_PASS=your_password

# IONOS Mail Credentials
IONOS_MAIL_URL=https://id.ionos.de/
IONOS_MAIL_USER=your_username
IONOS_MAIL_PASS=your_password

# Playwright Configuration (optional)
HEADLESS=true
# Optional installed browser channel, e.g. chrome
# PLAYWRIGHT_CHANNEL=chrome
# Optional persistent browser profile (use a dedicated profile directory)
# PLAYWRIGHT_USER_DATA_DIR=playwright-profile
# Optional connection to an already authenticated Chrome instance
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
# Docker mounts this ignored file as the MagentaCloud authentication state.
# Create playwright/.auth/magentacloud.json once from an authenticated browser.

# Add additional credentials here as needed
# For new services, follow the pattern:
# SERVICE_NAME_USER=username
# SERVICE_NAME_PASS=password
